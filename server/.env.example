# --- Storefront API ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crave_en
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Where the React storefront runs (used for CORS and links in emails). Comma-separate several if needed.
CLIENT_URL=http://localhost:5174
# This API's own address (used to build full links to uploaded photos)
PUBLIC_URL=http://localhost:5000

# Flat delivery charge in rupees (pickup is always free)
DELIVERY_FEE=40
# Used to work out "today" and which time slots are still open
TIMEZONE=Asia/Kolkata
BAKERY_NAME=Crave En

# --- Admin account created by `npm run seed` ---
ADMIN_NAME=Bakery Owner
ADMIN_EMAIL=owner@bakery.local
ADMIN_PASSWORD=change-this-password

# --- Link to the Smart Inventory System (FastAPI) ---
# Base URL of the inventory backend, without /api
INVENTORY_API_URL=http://127.0.0.1:8000
# Must be exactly the same value as INTEGRATION_SECRET in the inventory backend
INTEGRATION_SECRET=dev-integration-secret
# How often (seconds) to retry orders that could not be delivered to the inventory app
SYNC_INTERVAL_SECONDS=30

# --- Optional: each feature switches itself on when its settings are filled in ---

# Photo uploads. Without this, photos are saved in server/uploads (fine on your computer).
# On Render you need Cloudinary, because Render wipes the disk on every restart.
# Free account: cloudinary.com > Dashboard > "API environment variable"
CLOUDINARY_URL=

# "Continue with Google". Create an OAuth client ID (type: Web application) at
# console.cloud.google.com > APIs & Services > Credentials, and add your site
# (e.g. http://localhost:5174) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Emails (order confirmations, password reset). Without these, emails are printed
# in this terminal instead. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=a 16-letter app password (Google Account >
# Security > App passwords; needs 2-step verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
