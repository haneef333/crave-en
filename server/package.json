{
  "name": "crave-en-server",
  "version": "1.0.0",
  "description": "Express + MongoDB API for Crave En, a home bakery shop. Sends accepted orders to the Smart Inventory System.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
